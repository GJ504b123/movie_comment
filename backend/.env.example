# 把本文件复制为 backend/.env 并填好值即可生效
# （application.yml 已配置 spring.config.import 直接读取 backend/.env，
#   注意启动时工作目录要在 backend/ 下，例如：cd backend && mvnw spring-boot:run）

# === 数据库 ===
DB_URL=jdbc:mysql://localhost:3306/movie_comment?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=改成你的密码

# === JWT ===
JWT_SECRET=用一段至少32字符的随机串替换此处
JWT_EXPIRE_MINUTES=120

# === 服务器 ===
SERVER_PORT=8080
